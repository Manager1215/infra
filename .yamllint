---
extends: default
ignore: |
  roles/monitoring/files/grafana/dashboards/
  sites/
rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  comments-indentation: false
