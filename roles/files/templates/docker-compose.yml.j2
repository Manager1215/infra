# {{ ansible_managed }}
services:
  filebrowser:
    image: {{ files_image }}
    container_name: filebrowser
    restart: unless-stopped
    user: "{{ files_uid }}:{{ files_gid }}"
    command: --address 0.0.0.0 --port 8080 --root /srv --database /database.db
    ports:
      - "127.0.0.1:{{ files_port }}:8080"
    volumes:
      - ./data:/srv
      - ./database.db:/database.db
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
