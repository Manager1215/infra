# {{ ansible_managed }}
[Unit]
Description=Kiln website: accounts and reports
After=network-online.target
Wants=network-online.target

[Service]
User={{ kiln_site_accounts_user }}
Group={{ kiln_site_accounts_user }}
Environment=KILN_ENV_FILE=/etc/kiln-accounts/env
ExecStart=/usr/bin/python3 -I /usr/local/bin/kiln-accounts.py serve
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=kiln-accounts
StateDirectoryMode=0700

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax={{ kiln_site_accounts_memory_max }}

[Install]
WantedBy=multi-user.target
