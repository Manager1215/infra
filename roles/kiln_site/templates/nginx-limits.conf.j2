# {{ ansible_managed }}
map $request_method $kiln_post_addr {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $kiln_post_addr zone=kiln_write:1m rate=12r/m;
limit_req_zone $kiln_post_addr zone=kiln_auth:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=kiln_read:2m rate=120r/m;

# no query string and referer, email links carry one-time keys
log_format kiln_account '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                        '$status $body_bytes_sent "-" "$http_user_agent"';
