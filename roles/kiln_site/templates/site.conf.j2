# {{ ansible_managed }}
{% set names = [kiln_site_domain] + kiln_site_aliases %}
{% macro accounts_proxy() %}
        proxy_pass http://127.0.0.1:{{ kiln_site_accounts_port }};
{%- endmacro %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ names | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ static_sites_acme_root }};
        default_type text/plain;
    }

{% if kiln_site_has_cert | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    root {{ kiln_site_root }};
{% endif %}
}
{% if kiln_site_has_cert | bool %}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ names | join(' ') }};

    ssl_certificate /etc/letsencrypt/live/{{ kiln_site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ kiln_site_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{ kiln_site_root }};
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;

    location ^~ /.well-known/acme-challenge/ {
        root {{ static_sites_acme_root }};
        default_type text/plain;
    }

    location ~ /\. { return 404; }

    location = /account { return 301 /account/; }
    location ^~ /account/ {
        access_log /var/log/nginx/access.log kiln_account;
        limit_req zone=kiln_read burst=60 nodelay;
        limit_req zone=kiln_write burst=6 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
{{ accounts_proxy() }}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;

        location ~ ^/account/(signin|signup|reset|reset/new|welcome)$ {
            access_log /var/log/nginx/access.log kiln_account;
            limit_req zone=kiln_read burst=60 nodelay;
            limit_req zone=kiln_auth burst=3 nodelay;
            limit_req_status 429;
{{ accounts_proxy() }}
        }
    }

    location ^~ /reports/ {
        limit_req zone=kiln_read burst=60 nodelay;
        limit_req zone=kiln_write burst=6 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
{{ accounts_proxy() }}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ~* \.(woff2|svg)$ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }
    location ~* \.(css|js|html|json)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
{% endif %}
